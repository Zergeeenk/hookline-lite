# Copiá este archivo a .env y completalo. .env NUNCA va al repo (está en .gitignore).
# En producción conviene cargar los secretos desde un gestor de secretos (vault) y no desde un archivo.

# --- general ---
HOOKLINE_ENTORNO=produccion
HOOKLINE_URL_PUBLICA=https://hookline.tudominio.com      # https: Instagram lo exige para la vuelta del login
HOOKLINE_ZONA_HORARIA=America/Argentina/Buenos_Aires
HOOKLINE_COOKIE_SEGURA=1
POSTGRES_PASSWORD=cambiame

# --- secretos (generalos: `hookline generar-clave` y cualquier texto largo al azar) ---
HOOKLINE_CLAVE_SECRETA=          # cifra los tokens de Instagram y el App Secret. Si se pierde, hay que reconectar todo.
HOOKLINE_CLAVE_SESION=           # firma las URLs públicas temporales

# --- app de Meta (o cargala desde Ajustes del panel: queda cifrada en la base) ---
HOOKLINE_META_APP_ID=
HOOKLINE_META_APP_SECRET=

# --- Claude ---
HOOKLINE_MOTOR_IA=api            # api | claude_code (también se cambia en Ajustes)
ANTHROPIC_API_KEY=               # solo para el motor api
HOOKLINE_MODELO=claude-opus-5-5
HOOKLINE_MODELO_RAPIDO=claude-haiku-5-5
HOOKLINE_ESFUERZO=medium

# --- archivos para Meta ---
HOOKLINE_ALMACEN=local           # local (este servicio sirve /publico/... firmado) | s3
HOOKLINE_S3_BUCKET=
HOOKLINE_S3_REGION=
HOOKLINE_S3_ENDPOINT=            # para MinIO / Cloudflare R2
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY si usás s3 (o rol del servidor)

# --- worker ---
HOOKLINE_MAX_RENDER=2
HOOKLINE_MAX_DESCARGAS=3
HOOKLINE_MAX_PUBLICANDO=2
HOOKLINE_BUSCADOR=1              # 0 = apaga el buscador de memes (Chrome)

# --- Pyro ---
HOOKLINE_WEBHOOK_URL=            # adónde mandar los eventos (pieza.publicada, cuenta.token_vencido, ...)
HOOKLINE_WEBHOOK_SECRETO=        # para firmar los webhooks (HMAC-SHA256)
HOOKLINE_ORIGENES_PERMITIDOS=    # CORS, si Pyro llama desde el navegador (separados por coma)
