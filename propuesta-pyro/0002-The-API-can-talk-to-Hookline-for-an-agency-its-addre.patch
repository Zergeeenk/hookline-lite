@@ -0,0 +1,108 @@
+package hooklinedb_test
+
+import (
+	"context"
+	"errors"
+	"io"
+	"slices"
+	"testing"
+
+	"modelpro/business/domain/hooklinebus"
+	"modelpro/business/domain/hooklinebus/stores/hooklinedb"
+	"modelpro/business/sdk/dbtest"
+	"modelpro/foundation/logger"
+)
+
+const agency = 1
+
+func newStore(t *testing.T) (*hooklinedb.Store, *dbtest.Database) {
+	t.Helper()
+	db := dbtest.NewSeeded(t)
+	return hooklinedb.NewStore(logger.New(io.Discard, logger.LevelInfo, "TEST", nil), db.DB), db
+}
+
+func TestConnection(t *testing.T) {
+	t.Parallel()
+	s, db := newStore(t)
+	ctx := context.Background()
+	user := dbtest.CreateUser(t, db.DB, agency, "ana", "chatter")
+
+	if _, err := s.Connection(ctx, agency); !errors.Is(err, hooklinebus.ErrOff) {
+		t.Fatalf("%v", err)
+	}
+	if err := s.SaveConnection(ctx, agency, user, []byte("sealed"), "1234"); err != nil {
+		t.Fatal(err)
+	}
+	got, err := s.Connection(ctx, agency)
+	if err != nil || string(got.Connection) != "sealed" || got.TokenHint != "1234" {
+		t.Fatalf("%+v %v", got, err)
+	}
+	if err := s.SaveConnection(ctx, agency, user, []byte("again"), "5678"); err != nil {
+		t.Fatal(err)
+	}
+	if got, _ = s.Connection(ctx, agency); string(got.Connection) != "again" || got.TokenHint != "5678" {
+		t.Fatalf("%+v", got)
+	}
+	if err := s.RemoveConnection(ctx, agency); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.Connection(ctx, agency); !errors.Is(err, hooklinebus.ErrOff) {
+		t.Fatalf("%v", err)
+	}
+}
+
+func TestPersonName(t *testing.T) {
+	t.Parallel()
+	s, db := newStore(t)
+	ctx := context.Background()
+	ana := dbtest.CreateUser(t, db.DB, agency, "ana", "chatter")
+	if name, err := s.PersonName(ctx, agency, ana); err != nil || name == "" {
+		t.Fatalf("%q %v", name, err)
+	}
+	if _, err := s.PersonName(ctx, agency+1, ana); !errors.Is(err, hooklinebus.ErrNotFound) {
+		t.Fatalf("%v", err)
+	}
+}
+
+// The admins are always told; of a model, only who works with her and holds
+// the permission, and only of the agency.
+func TestRecipients(t *testing.T) {
+	t.Parallel()
+	s, db := newStore(t)
+	ctx := context.Background()
+	maite := dbtest.CreateModel(t, db.DB, agency, "Maite")
+	otra := dbtest.CreateModel(t, db.DB, agency, "Otra")
+	jefa := dbtest.CreateUser(t, db.DB, agency, "jefa", "admin")
+	con := dbtest.CreateUser(t, db.DB, agency, "con", "creator")
+	sin := dbtest.CreateUser(t, db.DB, agency, "sin", "creator")
+	fuera := dbtest.CreateUser(t, db.DB, agency, "fuera", "creator")
+	baja := dbtest.CreateUser(t, db.DB, agency, "baja", "creator")
+	dbtest.Assign(t, db.DB, maite, con, "creator")
+	dbtest.Assign(t, db.DB, maite, sin, "creator")
+	dbtest.Assign(t, db.DB, otra, fuera, "creator")
+	dbtest.Assign(t, db.DB, maite, baja, "creator")
+	for _, u := range []int{con, fuera, baja} {
+		if _, err := db.DB.Exec(`INSERT INTO user_permissions (user_id, section, level) VALUES ($1, 'hookline', 'view')`, u); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := db.DB.Exec(`UPDATE users SET active = FALSE WHERE id = $1`, baja); err != nil {
+		t.Fatal(err)
+	}
+
+	admins, err := s.Recipients(ctx, agency, 0)
+	if err != nil || !slices.Contains(admins, jefa) || slices.Contains(admins, con) {
+		t.Fatalf("admins %v %v", admins, err)
+	}
+	got, err := s.Recipients(ctx, agency, maite)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !slices.Contains(got, jefa) || !slices.Contains(got, con) || slices.Contains(got, sin) || slices.Contains(got, fuera) || slices.Contains(got, baja) {
+		t.Fatalf("of Maite %v (jefa %d con %d sin %d fuera %d baja %d)", got, jefa, con, sin, fuera, baja)
+	}
+	other := dbtest.CreateAgency(t, db.DB, "Otra agencia")
+	if got, err := s.Recipients(ctx, other, maite); err != nil || slices.Contains(got, con) || slices.Contains(got, jefa) {
+		t.Fatalf("another agency %v %v", got, err)
+	}
+}
