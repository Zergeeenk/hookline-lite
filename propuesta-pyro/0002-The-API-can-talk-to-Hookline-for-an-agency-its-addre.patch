+package hooklinebus
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+
+	"modelpro/business/domain/notifbus"
+	"modelpro/business/sdk/validate"
+)
+
+const (
+	// MaxWebhook is the longest webhook taken.
+	MaxWebhook = 64 << 10
+	// webhookWithin is how far from now a webhook's time may be: an older
+	// one is a webhook played again.
+	webhookWithin = 5 * time.Minute
+	// NotifKind is the kind of the notifications of Hookline.
+	NotifKind = "hookline"
+	// notifLink is where the notifications take a person: the section's
+	// page.
+	notifLink = "/hookline"
+)
+
+// eventKey is a webhook taken, kept while its time is valid: the same one
+// twice tells nobody twice.
+type eventKey struct {
+	agency int
+	id     int64
+}
+
+// Webhook takes one of Hookline's webhooks for the agency: it checks the
+// signature (sha256=<hex of HMAC-SHA256(secret, "<time>.<body>")>) against
+// the agency's webhook secret in constant time, and a time within five
+// minutes of now. ErrSignature is every way of not being Hookline's, the
+// same for all, so nobody learns which agencies have one.
+//
+// pieza.error, pieza.vencida, cuenta.token_vencido and
+// cuenta.token_por_vencer tell the agency's admins and, when the account is
+// tied to a model, the people of that model who hold the Hookline
+// permission. Every other event is taken and nothing happens.
+func (b *Business) Webhook(ctx context.Context, agencyID int, tiempo, firma string, body []byte) error {
+	if len(body) > MaxWebhook {
+		return ErrSignature
+	}
+	c, err := b.current(ctx, agencyID)
+	if errors.Is(err, ErrOff) {
+		return ErrSignature
+	}
+	if err != nil {
+		return err
+	}
+	if c.WebhookSecret == "" || !signed(c.WebhookSecret, tiempo, firma, body, b.now()) {
+		return ErrSignature
+	}
+
+	var ev Event
+	if err := json.Unmarshal(body, &ev); err != nil {
+		return validate.Field("body", "an event of Hookline")
+	}
+	note, ok := noteOf(ev)
+	if !ok {
+		return nil
+	}
+	if !b.firstTime(agencyID, ev.ID) {
+		return nil
+	}
+	if b.notify == nil {
+		b.log.Info(ctx, "hookline: an event with nobody to tell", "tipo", ev.Tipo)
+		return nil
+	}
+	model := 0
+	if ev.Datos.PyroModeloID != nil && *ev.Datos.PyroModeloID > 0 {
+		model = *ev.Datos.PyroModeloID
+	}
+	who, err := b.storer.Recipients(ctx, agencyID, model)
+	if err != nil {
+		return fmt.Errorf("who to tell: %w", err)
+	}
+	for _, id := range who {
+		n := note
+		n.UserID = id
+		b.notify.Notify(ctx, agencyID, n)
+	}
+	return nil
+}
+
+// signed reports whether firma is the signature of the body at tiempo, and
+// tiempo is near now.
+func signed(secret, tiempo, firma string, body []byte, now time.Time) bool {
+	at, err := strconv.ParseInt(tiempo, 10, 64)
+	if err != nil {
+		return false
+	}
+	if d := now.Sub(time.Unix(at, 0)); d > webhookWithin || d < -webhookWithin {
+		return false
+	}
+	hexSum, ok := strings.CutPrefix(firma, "sha256=")
+	if !ok {
+		return false
+	}
+	got, err := hex.DecodeString(hexSum)
+	if err != nil {
+		return false
+	}
+	mac := hmac.New(sha256.New, []byte(secret))
+	mac.Write([]byte(tiempo + "."))
+	mac.Write(body)
+	return hmac.Equal(got, mac.Sum(nil))
+}
+
+// Sign is the signature Hookline puts on a webhook, for a test's Hookline.
+func Sign(secret, tiempo string, body []byte) string {
+	mac := hmac.New(sha256.New, []byte(secret))
+	mac.Write([]byte(tiempo + "."))
+	mac.Write(body)
+	return "sha256=" + hex.EncodeToString(mac.Sum(nil))
+}
+
+// firstTime reports whether a webhook was not taken before, while its time
+// is valid. An event without an id is always new.
+func (b *Business) firstTime(agencyID int, id int64) bool {
+	if id == 0 {
+		return true
+	}
+	now := b.now()
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	keepFresh(b.events, now, 2*webhookWithin)
+	k := eventKey{agency: agencyID, id: id}
+	if _, seen := b.events[k]; seen {
+		return false
+	}
+	b.events[k] = now
+	return true
+}
+
+// noteOf is what an event tells people, in Spanish; false for an event
+// that tells nobody.
+func noteOf(ev Event) (notifbus.Note, bool) {
+	d := ev.Datos
+	cuenta := "una cuenta"
+	if d.Cuenta != "" {
+		cuenta = "@" + d.Cuenta
+	}
+	pieza := "Una pieza"
+	if d.Pieza != "" {
+		pieza = "La pieza " + d.Pieza
+	}
+	n := notifbus.Note{Kind: NotifKind, Link: notifLink}
+	switch ev.Tipo {
+	case "pieza.error":
+		n.Title = "Hookline: una pieza no se pudo publicar"
+		n.Body = fmt.Sprintf("%s de %s no salió.", pieza, cuenta)
+		if d.Error != "" {
+			n.Body = fmt.Sprintf("%s de %s no salió: %s.", pieza, cuenta, strings.TrimRight(d.Error, ". "))
+		}
+		n.Body += " Fijate en Hookline y probá de nuevo."
+	case "pieza.vencida":
+		n.Title = "Hookline: una pieza se quedó sin salir"
+		n.Body = fmt.Sprintf("%s de %s se pasó de su hora sin publicarse. Reprogramala o cancelala en Hookline.", pieza, cuenta)
+	case "cuenta.token_vencido":
+		n.Title = "Hookline: hay que reconectar " + cuenta
+		n.Body = fmt.Sprintf("Se venció el permiso de Instagram de %s: hasta que la conectes de nuevo en Hookline no se publica nada.", cuenta)
+	case "cuenta.token_por_vencer":
+		n.Title = "Hookline: el permiso de " + cuenta + " está por vencer"
+		n.Body = fmt.Sprintf("El permiso de Instagram de %s vence pronto. Reconectala en Hookline antes de que se corte.", cuenta)
+		if days := d.Dias.String(); days != "" {
+			n.Body = fmt.Sprintf("El permiso de Instagram de %s vence en %s días. Reconectala en Hookline antes de que se corte.", cuenta, days)
+		}
+	default:
+		return notifbus.Note{}, false
+	}
+	return n, true
+}
