+				}
+			}
+		}
+		if c.header.Get("X-Evil") != "" {
+			t.Error("a name put a header")
+		}
+		actors[c.header.Get("X-Hookline-Actor")] = true
+	}
+	for _, want := range []string{
+		"reels (pyro:" + strconv.Itoa(w.editorID) + ")",
+		"jefa (pyro:" + strconv.Itoa(w.adminID) + ")",
+		"Senora Agata X-Evil: 1 (pyro:" + strconv.Itoa(w.lectID) + ")",
+	} {
+		if !actors[want] {
+			t.Errorf("no request for %q: %v", want, actors)
+		}
+	}
+}
