+// Who is not an admin sees the accounts of their models, and everything of
+// another model's account, or of one tied to none, does not exist: its
+// pieces, their operations, their thumbnails, its stats and comments.
+func TestModelScope(t *testing.T) {
+	w := newWorld(t)
+	w.connect()
+
+	var out struct {
+		Cuentas []struct {
+			ID string `json:"id"`
+		} `json:"cuentas"`
+		Piezas []struct {
+			ID     string `json:"id"`
+			Cuenta string `json:"cuenta"`
+		} `json:"piezas"`
+	}
+	ids := func() []string {
+		var got []string
+		for _, c := range out.Cuentas {
+			got = append(got, c.ID)
+		}
+		return got
+	}
+	w.s.Expect(http.StatusOK, http.MethodGet, "/api/hookline/cuentas", w.editor, nil, &out)
+	if got := ids(); !slices.Equal(got, []string{"pamela"}) {
+		t.Fatalf("editor's accounts %v", got)
+	}
+	w.s.Expect(http.StatusOK, http.MethodGet, "/api/hookline/cuentas", w.otherEditor, nil, &out)
+	if got := ids(); !slices.Equal(got, []string{"otra"}) {
+		t.Fatalf("the other editor's accounts %v", got)
+	}
+	w.s.Expect(http.StatusOK, http.MethodGet, "/api/hookline/cuentas", w.admin, nil, &out)
+	if got := ids(); !slices.Equal(got, []string{"pamela", "otra", "suelta"}) {
+		t.Fatalf("admin's accounts %v", got)
+	}
+	status, raw := w.s.Do(http.MethodGet, "/api/hookline/cuentas", w.editor, nil)
+	if status != http.StatusOK || strings.Contains(string(raw), `"piezas"`) || strings.Contains(string(raw), "version") {
+		t.Fatalf("only the accounts: %s", raw)
+	}
+
+	w.s.Expect(http.StatusOK, http.MethodGet, "/api/hookline/piezas?cuenta=pamela", w.lect, nil, &out)
+	if len(out.Piezas) != 1 || out.Piezas[0].ID != "p1" {
+		t.Fatalf("pamela's pieces %+v", out.Piezas)
+	}
+	w.s.Expect(http.StatusOK, http.MethodGet, "/api/hookline/piezas?cuenta=suelta", w.admin, nil, &out)
+	if len(out.Piezas) != 1 || out.Piezas[0].ID != "p3" {
+		t.Fatalf("admin's suelta pieces %+v", out.Piezas)
+	}
+
+	// A Hookline that answers more than it was asked does not open more.
+	w.f.mu.Lock()
+	w.f.loose = true
+	w.f.mu.Unlock()
+	w.s.Expect(http.StatusOK, http.MethodGet, "/api/hookline/piezas?cuenta=pamela", w.editor, nil, &out)
+	if len(out.Piezas) != 1 || out.Piezas[0].Cuenta != "pamela" {
+		t.Fatalf("loose pieces %+v", out.Piezas)
+	}
+	w.f.mu.Lock()
+	w.f.loose = false
+	w.f.mu.Unlock()
+
+	w.f.reset()
+	for _, tok := range []string{w.editor, w.lect} {
+		for _, path := range []string{
+			"/api/hookline/piezas?cuenta=otra", "/api/hookline/piezas?cuenta=suelta", "/api/hookline/piezas?cuenta=nadie",
+			"/api/hookline/stats?cuenta=otra", "/api/hookline/stats?cuenta=suelta",
+			"/api/hookline/comentarios?cuenta=otra", "/api/hookline/comentarios?cuenta=suelta",
+			"/api/hookline/mini?p=para-subir/otra/b.jpg", "/api/hookline/mini?p=para-subir/suelta/c.jpg",
+			"/api/hookline/mini?p=para-subir/pamela/no-es-de-ninguna.jpg", "/api/hookline/mini?p=../datos/ajustes.json", "/api/hookline/mini",
+		} {
+			if status, raw := w.s.Do(http.MethodGet, path, tok, nil); status != http.StatusNotFound {
+				t.Errorf("%s: %d %s", path, status, raw)
+			}
+		}
+	}
+	for _, body := range []map[string]any{
+		{"op": "jueces", "id": "p2"}, {"op": "cancelar", "id": "p3"}, {"op": "caption", "id": "p2", "caption": "otra"},
+		{"op": "programar", "id": "p2", "cuando": "2026-11-20T20:00"}, {"op": "jueces", "id": "p9"},
+	} {
+		if status, raw := w.s.Do(http.MethodPost, "/api/hookline/pieza", w.editor, body); status != http.StatusNotFound {
+			t.Errorf("pieza %v: %d %s", body, status, raw)
+		}
+	}
+	for _, c := range []string{"otra", "suelta"} {
+		if status, raw := w.s.Do(http.MethodPost, "/api/hookline/comentario", w.editor, map[string]any{"op": "responder", "cuenta": c, "comentario": "c1", "texto": "gracias"}); status != http.StatusNotFound {
+			t.Errorf("comentario %s: %d %s", c, status, raw)
+		}
+	}
+	for _, c := range w.f.seen() {
+		if c.path != "/api/estado" && !(c.method == http.MethodGet && c.path == "/api/piezas" && c.query == "") {
+			t.Errorf("reached Hookline outside the scope: %s %s?%s", c.method, c.path, c.query)
+		}
+	}
+
+	// The thumbnail of a piece in the scope comes, as a JPEG with nosniff.
+	res, err := w.s.Client().Do(authed(t, w.s.URL()+"/api/hookline/mini?p=para-subir/pamela/a.jpg", w.lect))
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, _ := io.ReadAll(res.Body)
+	res.Body.Close()
+	if res.StatusCode != http.StatusOK || string(body) != jpeg || res.Header.Get("Content-Type") != "image/jpeg" || res.Header.Get("X-Content-Type-Options") != "nosniff" {
+		t.Fatalf("mini: %d %q %v", res.StatusCode, body, res.Header)
+	}
+	if got := w.f.seen(); got[len(got)-1].path != "/mini" || got[len(got)-1].query != "p=para-subir%2Fpamela%2Fa.jpg" {
+		t.Fatalf("mini asked as %+v", got[len(got)-1])
+	}
+
+	// An admin reaches the account tied to no model.
+	w.s.Expect(http.StatusOK, http.MethodPost, "/api/hookline/pieza", w.admin, map[string]any{"op": "jueces", "id": "p3"}, nil)
+	w.s.Expect(http.StatusOK, http.MethodGet, "/api/hookline/mini?p=para-subir/suelta/c.jpg", w.admin, nil, nil)
+
+	// A model taken from the account in Hookline closes it within a minute
+	// at most; a new list of accounts closes it at once.
+	w.f.mu.Lock()
+	moved := make([]map[string]any, len(w.f.cuentas))
+	for i, c := range w.f.cuentas {
+		moved[i] = maps.Clone(c)
+	}
+	moved[0]["pyro_modelo_id"] = w.otra
+	w.f.cuentas = moved
+	w.f.mu.Unlock()
+	w.s.Expect(http.StatusOK, http.MethodGet, "/api/hookline/cuentas", w.editor, nil, &out)
+	if len(out.Cuentas) != 0 {
+		t.Fatalf("accounts after the change %+v", out.Cuentas)
+	}
+	if status, _ := w.s.Do(http.MethodGet, "/api/hookline/piezas?cuenta=pamela", w.editor, nil); status != http.StatusNotFound {
+		t.Fatalf("pamela after the change: %d", status)
+	}
+}
