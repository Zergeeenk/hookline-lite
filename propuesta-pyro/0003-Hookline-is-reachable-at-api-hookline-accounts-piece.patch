+// A Hookline down answers 502 with its code, says nothing of why, and
+// touches nothing else; one that is gone is not tried again for a while.
+func TestHooklineDown(t *testing.T) {
+	w := newWorld(t)
+	w.connect()
+	for name, answer := range map[string]func(w http.ResponseWriter, r *http.Request){
+		"500": func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusInternalServerError)
+			io.WriteString(w, `{"error":"secret detail of the failure"}`)
+		},
+		"html": func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Type", "text/html")
+			io.WriteString(w, `<html>a page of a proxy</html>`)
+		},
+		"not json": func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Type", "application/json")
+			io.WriteString(w, `{"cuentas": [`)
+		},
+		"empty": func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Type", "application/json")
+		},
+		"redirect": func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Location", "https://otro.example.org/")
+			w.WriteHeader(http.StatusFound)
+		},
+	} {
+		w.f.on("GET /api/stats", answer)
+		status, raw := w.s.Do(http.MethodGet, "/api/hookline/stats?cuenta=pamela", w.admin, nil)
+		if status != http.StatusBadGateway || !strings.Contains(string(raw), `"hookline_down"`) || strings.Contains(string(raw), "secret detail") || strings.Contains(string(raw), "html") {
+			t.Errorf("%s: %d %s", name, status, raw)
+		}
+	}
+	w.f.on("GET /api/stats", func(w http.ResponseWriter, r *http.Request) {
+		web.RespondError(w, http.StatusForbidden, "rol")
+	})
+	if status, raw := w.s.Do(http.MethodGet, "/api/hookline/stats?cuenta=pamela", w.admin, nil); status != http.StatusBadGateway || !strings.Contains(string(raw), `"hookline_refused"`) {
+		t.Errorf("refused: %d %s", status, raw)
+	}
+	w.f.on("GET /mini", func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/html")
+		io.WriteString(w, `<script>alert(1)</script>`)
+	})
+	if status, raw := w.s.Do(http.MethodGet, "/api/hookline/mini?p=para-subir/pamela/a.jpg", w.admin, nil); status != http.StatusBadGateway {
+		t.Errorf("a thumbnail that is not one: %d %s", status, raw)
+	}
+	w.f.on("GET /mini", func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "image/jpeg")
+		w.Write(make([]byte, 5<<20+1))
+	})
+	if status, raw := w.s.Do(http.MethodGet, "/api/hookline/mini?p=para-subir/pamela/a.jpg", w.admin, nil); status != http.StatusBadGateway {
+		t.Errorf("a thumbnail too big: %d %.100s", status, raw)
+	}
+
+	// Gone: the connection fails, and the next one does not even try.
+	w.f.srv.Close()
+	start := time.Now()
+	for range 3 {
+		status, raw := w.s.Do(http.MethodGet, "/api/hookline/cuentas", w.admin, nil)
+		if status != http.StatusBadGateway || !strings.Contains(string(raw), `"hookline_down"`) {
+			t.Fatalf("gone: %d %s", status, raw)
+		}
+	}
+	if took := time.Since(start); took > 4*time.Second {
+		t.Fatalf("a Hookline that is gone took %v", took)
+	}
+	// Nothing else notices.
+	w.s.Expect(http.StatusOK, http.MethodGet, "/api/hookline/settings", w.admin, nil, nil)
+}
