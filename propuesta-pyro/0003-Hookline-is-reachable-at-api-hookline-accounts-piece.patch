+	w.s.Expect(http.StatusOK, http.MethodGet, "/api/hookline/stats?cuenta=pamela", w.lect, nil, nil)
+	seen := w.f.seen()
+	if len(seen) == 0 {
+		t.Fatal("nothing reached Hookline")
+	}
+	actors := map[string]bool{}
+	for _, c := range seen {
+		if c.header.Get("Authorization") != "Bearer "+hooklineToken {
+			t.Errorf("%s %s went with %q", c.method, c.path, c.header.Get("Authorization"))
+		}
+		for k, vs := range c.header {
+			for _, v := range vs {
+				for _, tok := range []string{w.editor, w.admin, w.lect} {
+					if strings.Contains(v, tok) {
+						t.Errorf("the CRM's token went in %s", k)
