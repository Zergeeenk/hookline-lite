+package hooklineapp_test
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"math/rand/v2"
+	"net"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+)
+
+/* Breaking the bridge: requests with raw request lines, so no client tidies
+   a path up, and a Hookline that writes down each request as it came. */
+
+// listed are the requests the bridge may make to Hookline.
+var listed = map[string]bool{
+	"GET /api/estado": true, "GET /api/piezas": true, "GET /api/stats": true, "GET /api/comentarios": true,
+	"GET /mini": true, "POST /api/pieza": true, "POST /api/comentario": true,
+}
+
+// rawRequest sends a request with exactly that request line, untouched by a
+// client, and returns the status.
+func rawRequest(t *testing.T, base, method, target, token string, extra http.Header, body string) int {
+	t.Helper()
+	u, _ := url.Parse(base)
+	conn, err := net.DialTimeout("tcp", u.Host, 3*time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(8 * time.Second))
+	var b strings.Builder
+	fmt.Fprintf(&b, "%s %s HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n", method, target, u.Host)
+	if token != "" {
+		fmt.Fprintf(&b, "Authorization: Bearer %s\r\n", token)
+	}
+	for k, vs := range extra {
+		for _, v := range vs {
+			fmt.Fprintf(&b, "%s: %s\r\n", k, v)
+		}
+	}
+	if body != "" {
+		fmt.Fprintf(&b, "Content-Type: application/json\r\nContent-Length: %d\r\n", len(body))
+	}
+	b.WriteString("\r\n" + body)
+	if _, err := conn.Write([]byte(b.String())); err != nil {
+		t.Fatal(err)
+	}
+	res, err := http.ReadResponse(bufio.NewReader(conn), nil)
+	if err != nil {
+		return -1
+	}
+	defer res.Body.Close()
+	io.Copy(io.Discard, io.LimitReader(res.Body, 1<<20))
+	return res.StatusCode
+}
+
+// Odd paths and values under /api/hookline, at random, with every method
+// and every person: none is a 5xx, none reaches Hookline off the list, no
+// header of the browser goes on, and nothing of another model's account is
+// ever asked for.
+func TestStrangeRoutesNeverReachHookline(t *testing.T) {
+	w := newWorld(t)
+	w.connect()
+
+	pieces := []string{
+		"cuentas", "piezas", "pieza", "stats", "comentarios", "comentario", "mini", "settings", "settings/test", "webhook", "webhook/1",
+		"estado", "ajustes", "media", "subir", "chat", "pyro", "actividad", "..", ".", "%2e%2e", "%2E%2E", "%2f", "%2F", "%5c", "%252e%252e",
+		"a%00b", "%00", "a%0d%0aX-Evil:1", "..;", "a;b", "é", "%E2%80%AE", "%ef%bc%8f", "%c0%af", "a%20b", "cuentas%2f..%2fajustes",
+		"piezas/", "mini/", "CUENTAS", "Piezas", strings.Repeat("a", 300), "1", "-1", "0x10",
+	}
+	queries := []string{
+		"", "?cuenta=pamela", "?cuenta=otra", "?cuenta=suelta", "?cuenta=..%2Fajustes", "?cuenta=pamela&cuenta=otra", "?cuenta=otra&cuenta=pamela",
+		"?cuenta=pamela%26x%3D1", "?cuenta=%00", "?cuenta=" + strings.Repeat("a", 100), "?p=para-subir/otra/b.jpg", "?p=../datos/ajustes.json",
+		"?p=para-subir/pamela/a.jpg&p=para-subir/otra/b.jpg", "?p=%2Fetc%2Fpasswd", "?p=para-subir/pamela/a.jpg%00.png", "?cuenta=pamela;otra",
+		"?p=" + strings.Repeat("x", 2000), "?cuenta[]=pamela", "?CUENTA=otra",
+	}
+	bodies := []string{
+		``, `{}`, `{"op":"jueces","id":"p2"}`, `{"op":"publicar","id":"p1"}`, `{"op":"jueces","id":"p1","cuenta":"otra"}`,
+		`{"op":"responder","cuenta":"otra","comentario":"c1","texto":"x"}`, `{"op":"ocultar","cuenta":"pamela","comentario":"../../x"}`,
+		`{"op":["jueces"],"id":"p1"}`, `{"op":"jueces","id":{"$ne":1}}`, `[1,2]`, `nope`, `{"op":"programar","id":"p1","cuando":"2026-11-20T20:00\r\nX: 1"}`,
+		`{"url":"https://169.254.169.254","token":"hl_aaaaaaaaaaaaaaaaaaaaaa"}`,
+	}
+	methods := []string{"GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS", "TRACE"}
+	tokens := map[string]string{"admin": w.admin, "editor": w.editor, "reader": w.lect, "outside": w.outside, "nobody": ""}
+	extra := http.Header{"Cookie": {"session=1"}, "X-Forwarded-For": {"1.2.3.4"}, "X-Original-Url": {"/api/ajustes"}, "X-Http-Method-Override": {"DELETE"}}
+
+	rng := rand.New(rand.NewPCG(20261114, 7))
+	pick := func(list []string) string { return list[rng.IntN(len(list))] }
+	failed := map[string]bool{}
+	for range 1500 {
+		target := "/api/hookline/" + pick(pieces)
+		if rng.IntN(3) == 0 {
+			target += "/" + pick(pieces)
+		}
+		target += pick(queries)
+		who := pick([]string{"admin", "editor", "reader", "outside", "nobody"})
+		method := pick(methods)
+		if status := rawRequest(t, w.s.URL(), method, target, tokens[who], extra, pick(bodies)); status >= http.StatusInternalServerError || status < 0 {
+			failed[fmt.Sprintf("%d %s %s [%s]", status, method, target, who)] = true
+		}
+	}
+	for _, target := range []string{
+		"/api/hookline//cuentas", "/api/hookline/./cuentas", "/api/hookline/cuentas/", "/api/hookline/%63uentas", "/API/HOOKLINE/cuentas",
+		"/api/hookline/../hookline/cuentas", "/api//hookline/cuentas", "/api/hookline/cuentas;x=1", "/api/hookline/%2e%2e/auth/me",
+		"/api/hookline/webhook/1/../../settings", "/api/hookline/webhook/%2e%2e", "/api/hookline/webhook/1%2f..%2f..%2fsettings",
+	} {
+		for _, m := range methods {
+			if status := rawRequest(t, w.s.URL(), m, target, w.admin, extra, `{}`); status >= http.StatusInternalServerError || status < 0 {
+				failed[fmt.Sprintf("%d %s %s", status, m, target)] = true
+			}
+		}
+	}
+
+	for _, c := range w.f.seen() {
+		if !listed[c.method+" "+c.path] {
+			t.Errorf("reached Hookline off the list: %s %s?%s", c.method, c.path, c.query)
+		}
+		for _, h := range []string{"Cookie", "X-Evil", "X-Forwarded-For", "X-Original-Url", "X-Http-Method-Override"} {
+			if c.header.Get(h) != "" {
+				t.Errorf("header %s went on", h)
+			}
+		}
+		q, _ := url.ParseQuery(c.query)
+		switch {
+		case len(q["cuenta"]) > 1 || len(q["p"]) > 1:
+			t.Errorf("a repeated value went on: %s %s?%s", c.method, c.path, c.query)
+		case q.Get("cuenta") != "" && !ownOrAdmin(q.Get("cuenta")):
+			t.Errorf("an unknown account was asked for: %s %s?%s", c.method, c.path, c.query)
+		case c.path == "/mini" && !strings.HasPrefix(q.Get("p"), "para-subir/"):
+			t.Errorf("a thumbnail off the pieces: %s", c.query)
+		case c.method == http.MethodPost && strings.Contains(c.body, "\r"),
+			c.method == http.MethodPost && strings.Contains(c.body, `"otra"`) && !strings.HasPrefix(c.header.Get("X-Hookline-Actor"), "jefa "):
+			t.Errorf("a change outside went on: %s %s", c.path, c.body)
+		}
+	}
+	for k := range failed {
+		t.Errorf("failed: %s", k)
+	}
+}
+
+// ownOrAdmin is an account somebody of the test may ask for: pamela for the
+// team, otra and suelta for the admin alone.
+func ownOrAdmin(c string) bool { return c == "pamela" || c == "otra" || c == "suelta" }
+
+// A webhook's route takes nothing but a signed POST, and no other method
+// opens anything.
+func TestWebhookRouteTakesNothingElse(t *testing.T) {
+	w := newWorld(t)
+	w.connect()
+	for _, m := range []string{"GET", "PUT", "DELETE", "PATCH", "OPTIONS", "TRACE"} {
+		for _, tok := range []string{"", w.admin} {
+			if status := rawRequest(t, w.s.URL(), m, "/api/hookline/webhook/1", tok, nil, `{"id":1,"tipo":"pieza.error"}`); status >= http.StatusOK && status < http.StatusBadRequest || status >= http.StatusInternalServerError {
+				t.Errorf("%s with a login %v: %d", m, tok != "", status)
+			}
+		}
+	}
+	if status := rawRequest(t, w.s.URL(), "POST", "/api/hookline/webhook/1", w.admin, nil, `{"id":1,"tipo":"pieza.error"}`); status != http.StatusUnauthorized {
+		t.Errorf("a login is no signature: %d", status)
+	}
+	if got := w.told(); len(got) != 0 {
+		t.Fatalf("told %v", got)
+	}
+	if got := w.f.seen(); len(got) != 0 {
+		t.Fatalf("reached Hookline: %+v", got)
+	}
+}
diff --git a/app/domain/hooklineapp/hooklineapp.go b/app/domain/hooklineapp/hooklineapp.go
new file mode 100644
index 0000000..189fadb
--- /dev/null
+++ b/app/domain/hooklineapp/hooklineapp.go
@@ -0,0 +1,382 @@
+// Package hooklineapp serves /api/hookline, the bridge to Hookline, the
+// community manager of the models' Instagram accounts: a closed list of
+// routes. What is not on the list is a 404 and never reaches Hookline.
+//
+// Who may do what:
+//   - view, with Hookline to view: the accounts, their pieces, the
+//     thumbnails of their files, their stats and their comments, of the
+//     models in their scope;
+//   - edit, with Hookline to edit: the judges, the caption, scheduling and
+//     cancelling a piece, and answering, hiding or leaving a comment;
+//   - an admin alone (the role in the database, the scope of every model,
+//     with the section to edit): the connection.
+//
+// Nobody without the permission gets a request out: the gate answers 403
+// before anything is called. Hookline's webhooks come in at
+// POST /api/hookline/webhook/{agencyID}, with no login: their signature is
+// what lets them in.
+package hooklineapp
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+
+	"modelpro/app/sdk/request"
+	"modelpro/app/sdk/web"
+	"modelpro/business/domain/hooklinebus"
+	"modelpro/business/domain/userbus"
+	"modelpro/business/types/modelscope"
+	"modelpro/foundation/logger"
+)
+
+// Config contains all the mandatory systems required by handlers.
+type Config struct {
+	Log         *logger.Logger
+	HooklineBus *hooklinebus.Business
+}
+
+type app struct {
+	log *logger.Logger
+	bus *hooklinebus.Business
+}
+
+// Routes adds the closed list of routes.
+func Routes(rt web.Routers, cfg Config) {
+	api := &app{log: cfg.Log, bus: cfg.HooklineBus}
+
+	view := rt.App.With(rt.Require(userbus.SectionHookline, userbus.LevelView))
+	edit := rt.App.With(rt.Require(userbus.SectionHookline, userbus.LevelEdit))
+	admin := edit.With(api.admin)
+
+	// What the section reads.
+	view.Get("/hookline/cuentas", api.cuentas)
+	view.Get("/hookline/piezas", api.piezas)
+	view.Get("/hookline/stats", api.stats)
+	view.Get("/hookline/comentarios", api.comentarios)
+	view.Get("/hookline/mini", api.mini)
+
+	// What a person does.
+	edit.Post("/hookline/pieza", api.pieza)
+	edit.Post("/hookline/comentario", api.comentario)
+
+	// An admin's.
+	admin.Get("/hookline/settings", api.settings)
+	admin.Put("/hookline/settings", api.saveSettings)
+	admin.Delete("/hookline/settings", api.removeSettings)
+	admin.Post("/hookline/settings/test", api.checkSettings)
+
+	// Hookline's webhooks: no login, the signature lets them in.
+	rt.Public.Post("/hookline/webhook/{agencyID}", api.webhook)
+
+	// Everything else under /hookline, whatever the method: not on the list.
+	rt.App.HandleFunc("/hookline/*", func(w http.ResponseWriter, r *http.Request) {
+		web.RespondError(w, http.StatusNotFound, "not found")
+	})
+}
+
+// admin lets an admin through: the role in the database, the scope of every
+// model. The gate in front of it has asked for the section to edit.
+func (a *app) admin(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, scope, ok := request.Scoped(a.log, w, r)
+		if !ok {
+			return
+		}
+		if !scope.All {
+			web.RespondError(w, http.StatusForbidden, "only an admin")
+			return
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+// person is who the request goes for, and their scope.
+func (a *app) person(w http.ResponseWriter, r *http.Request) (hooklinebus.Person, modelscope.Scope, bool) {
+	caller, scope, ok := request.Scoped(a.log, w, r)
+	if !ok {
+		return hooklinebus.Person{}, modelscope.Scope{}, false
+	}
+	return hooklinebus.Person{AgencyID: caller.AgencyID, UserID: caller.UserID}, scope, true
+}
+
+// code answers an error with the code the screen acts on.
+func code(w http.ResponseWriter, status int, msg, c string) {
+	web.Respond(w, status, map[string]string{"error": msg, "code": c})
+}
+
+// fail answers an error of the bridge.
+func (a *app) fail(w http.ResponseWriter, r *http.Request, err error) {
+	switch {
+	case errors.Is(err, context.Canceled):
+		// The person left: nobody reads the answer.
+	case request.FieldError(w, err):
+	case errors.Is(err, hooklinebus.ErrNotFound):
+		web.RespondError(w, http.StatusNotFound, "not found")
+	case errors.Is(err, hooklinebus.ErrOff):
+		code(w, http.StatusServiceUnavailable, hooklinebus.ErrOff.Error(), "hookline_off")
+	case errors.Is(err, hooklinebus.ErrDown), errors.Is(err, context.DeadlineExceeded):
+		code(w, http.StatusBadGateway, hooklinebus.ErrDown.Error(), "hookline_down")
+	case errors.Is(err, hooklinebus.ErrRefused):
+		code(w, http.StatusBadGateway, hooklinebus.ErrRefused.Error(), "hookline_refused")
+	default:
+		request.Internal(a.log, w, r, err)
+	}
+}
+
+// answer answers what Hookline answered: a refusal (a 400, a 404) goes as
+// it came, so the screen can read why.
+func (a *app) answer(w http.ResponseWriter, r *http.Request, rep hooklinebus.Reply, err error) {
+	if err != nil {
+		a.fail(w, r, err)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(rep.Status)
+	w.Write(rep.Body)
+}
+
+// cuenta reads the account of the query: required, and one that cannot be
+// an id does not exist.
+func cuenta(w http.ResponseWriter, r *http.Request) (string, bool) {
+	c := r.URL.Query().Get("cuenta")
+	switch {
+	case c == "":
+		web.RespondFieldError(w, "cuenta", "the account")
+		return "", false
+	case !hooklinebus.ValidCuenta(c):
+		web.RespondError(w, http.StatusNotFound, "not found")
+		return "", false
+	}
+	return c, true
+}
+
+// =============================================================================
+// The connection
+
+// settingsView is the connection as an admin sees it, with the path where
+// Hookline sends its webhooks for the agency.
+type settingsView struct {
+	hooklinebus.Settings
+	WebhookPath string `json:"webhookPath"`
+}
+
+func (a *app) settingsOut(agencyID int, s hooklinebus.Settings) settingsView {
+	return settingsView{Settings: s, WebhookPath: "/api/hookline/webhook/" + strconv.Itoa(agencyID)}
+}
+
+func (a *app) settings(w http.ResponseWriter, r *http.Request) {
+	caller, _, ok := request.Scoped(a.log, w, r)
+	if !ok {
+		return
+	}
+	out, err := a.bus.Settings(r.Context(), caller.AgencyID)
+	if err != nil {
+		a.fail(w, r, err)
+		return
+	}
+	web.Respond(w, http.StatusOK, a.settingsOut(caller.AgencyID, out))
+}
+
+// settingsRequest is the body of PUT /api/hookline/settings. An empty token
+// or webhook secret keeps the one saved.
+type settingsRequest struct {
+	URL           string `json:"url"`
+	Token         string `json:"token"`
+	WebhookSecret string `json:"webhookSecret"`
+}
+
+func (a *app) saveSettings(w http.ResponseWriter, r *http.Request) {
+	caller, _, ok := request.Scoped(a.log, w, r)
+	if !ok {
+		return
+	}
+	var req settingsRequest
+	if !request.Decode(w, r, &req) {
+		return
+	}
+	out, err := a.bus.Save(r.Context(), caller.AgencyID, caller.UserID, hooklinebus.SaveSettings{URL: req.URL, Token: req.Token, WebhookSecret: req.WebhookSecret})
+	if err != nil {
+		a.fail(w, r, err)
+		return
+	}
+	web.Respond(w, http.StatusOK, a.settingsOut(caller.AgencyID, out))
+}
+
+func (a *app) removeSettings(w http.ResponseWriter, r *http.Request) {
+	caller, _, ok := request.Scoped(a.log, w, r)
+	if !ok {
+		return
+	}
+	if err := a.bus.Remove(r.Context(), caller.AgencyID); err != nil {
+		a.fail(w, r, err)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+func (a *app) checkSettings(w http.ResponseWriter, r *http.Request) {
+	p, _, ok := a.person(w, r)
+	if !ok {
+		return
+	}
+	out, err := a.bus.Check(r.Context(), p)
+	if err != nil {
+		a.fail(w, r, err)
+		return
+	}
+	web.Respond(w, http.StatusOK, out)
+}
+
+// =============================================================================
+// What the section reads
+
+func (a *app) cuentas(w http.ResponseWriter, r *http.Request) {
+	p, scope, ok := a.person(w, r)
+	if !ok {
+		return
+	}
+	rep, err := a.bus.Cuentas(r.Context(), p, scope)
+	a.answer(w, r, rep, err)
+}
+
+func (a *app) piezas(w http.ResponseWriter, r *http.Request) {
+	p, scope, ok := a.person(w, r)
+	if !ok {
+		return
+	}
+	c, ok := cuenta(w, r)
+	if !ok {
+		return
+	}
+	rep, err := a.bus.Piezas(r.Context(), p, scope, c)
+	a.answer(w, r, rep, err)
+}
+
+func (a *app) stats(w http.ResponseWriter, r *http.Request) {
+	p, scope, ok := a.person(w, r)
+	if !ok {
+		return
+	}
+	c, ok := cuenta(w, r)
+	if !ok {
+		return
+	}
+	rep, err := a.bus.Stats(r.Context(), p, scope, c)
+	a.answer(w, r, rep, err)
+}
+
+func (a *app) comentarios(w http.ResponseWriter, r *http.Request) {
+	p, scope, ok := a.person(w, r)
+	if !ok {
+		return
+	}
+	c, ok := cuenta(w, r)
+	if !ok {
+		return
+	}
+	rep, err := a.bus.Comentarios(r.Context(), p, scope, c)
+	a.answer(w, r, rep, err)
+}
+
+// mini serves the thumbnail of a file of a piece in the scope: a JPEG, with
+// nosniff. The address and the token of Hookline never reach the browser.
+func (a *app) mini(w http.ResponseWriter, r *http.Request) {
+	p, scope, ok := a.person(w, r)
+	if !ok {
+		return
+	}
+	raw, err := a.bus.Mini(r.Context(), p, scope, r.URL.Query().Get("p"))
+	if err != nil {
+		a.fail(w, r, err)
+		return
+	}
+	h := w.Header()
+	h.Set("Content-Type", "image/jpeg")
+	h.Set("X-Content-Type-Options", "nosniff")
+	h.Set("Cache-Control", "private, max-age=300")
+	h.Set("Content-Length", strconv.Itoa(len(raw)))
+	w.WriteHeader(http.StatusOK)
+	w.Write(raw)
+}
+
+// =============================================================================
+// What a person does
+
+// piezaRequest is the body of POST /api/hookline/pieza.
+type piezaRequest struct {
+	Op      string  `json:"op"`
+	ID      string  `json:"id"`
+	Caption *string `json:"caption"`
+	Cuando  *string `json:"cuando"`
+}
+
+func (a *app) pieza(w http.ResponseWriter, r *http.Request) {
+	p, scope, ok := a.person(w, r)
+	if !ok {
+		return
+	}
+	var req piezaRequest
+	if !request.Decode(w, r, &req) {
+		return
+	}
+	rep, err := a.bus.DoPieza(r.Context(), p, scope, hooklinebus.PiezaOp{Op: req.Op, ID: req.ID, Caption: req.Caption, Cuando: req.Cuando})
+	a.answer(w, r, rep, err)
+}
+
+// comentarioRequest is the body of POST /api/hookline/comentario.
+type comentarioRequest struct {
+	Op         string `json:"op"`
+	Cuenta     string `json:"cuenta"`
+	Comentario string `json:"comentario"`
+	Texto      string `json:"texto"`
+}
+
+func (a *app) comentario(w http.ResponseWriter, r *http.Request) {
+	p, scope, ok := a.person(w, r)
+	if !ok {
+		return
+	}
+	var req comentarioRequest
+	if !request.Decode(w, r, &req) {
+		return
+	}
+	rep, err := a.bus.DoComentario(r.Context(), p, scope, hooklinebus.ComentarioOp{Op: req.Op, Cuenta: req.Cuenta, Comentario: req.Comentario, Texto: req.Texto})
+	a.answer(w, r, rep, err)
+}
+
+// =============================================================================
+// Hookline's webhooks
+
+// webhook takes one of Hookline's webhooks. Whatever is wrong with it (no
+// such agency, no secret, a signature or a time that does not do) is the
+// same 401, so nobody learns which agencies have Hookline.
+func (a *app) webhook(w http.ResponseWriter, r *http.Request) {
+	defer r.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(r.Body, hooklinebus.MaxWebhook+1))
+	if err != nil {
+		web.RespondError(w, http.StatusBadRequest, "invalid request body")
+		return
+	}
+	if len(body) > hooklinebus.MaxWebhook {
+		web.RespondError(w, http.StatusRequestEntityTooLarge, "body too large")
+		return
+	}
+	agencyID, err := strconv.Atoi(web.Param(r, "agencyID"))
+	if err != nil || agencyID <= 0 {
+		web.RespondError(w, http.StatusUnauthorized, hooklinebus.ErrSignature.Error())
+		return
+	}
+	err = a.bus.Webhook(r.Context(), agencyID, r.Header.Get("X-Hookline-Tiempo"), r.Header.Get("X-Hookline-Firma"), body)
+	switch {
+	case err == nil:
+		w.WriteHeader(http.StatusNoContent)
+	case errors.Is(err, hooklinebus.ErrSignature):
+		web.RespondError(w, http.StatusUnauthorized, hooklinebus.ErrSignature.Error())
+	case request.FieldError(w, err):
+	default:
+		request.Internal(a.log, w, r, err)
+	}
+}
