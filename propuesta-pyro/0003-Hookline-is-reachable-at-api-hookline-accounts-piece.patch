+// call is one request as the fake Hookline got it.
+type call struct {
+	method, path, query, body string
+	header                    http.Header
+}
+
+// fakeHookline is Hookline as these tests play it: its accounts, its pieces
+// and whatever each test changes. Every request is written down, so a test
+// can say that nothing reached it.
+type fakeHookline struct {
+	srv *httptest.Server
+
+	mu    sync.Mutex
+	calls []call
+	// cuentas and piezas are what /api/estado and /api/piezas say.
+	cuentas []map[string]any
+	piezas  []map[string]any
+	// loose answers every piece whatever account was asked for.
+	loose   bool
+	answers map[string]func(w http.ResponseWriter, r *http.Request)
+}
+
+func newFake(t *testing.T) *fakeHookline {
+	f := &fakeHookline{answers: map[string]func(w http.ResponseWriter, r *http.Request){}}
+	f.srv = httptest.NewServer(http.HandlerFunc(f.serve))
+	t.Cleanup(f.srv.Close)
+	return f
+}
+
+func (f *fakeHookline) serve(w http.ResponseWriter, r *http.Request) {
+	raw, _ := io.ReadAll(r.Body)
+	f.mu.Lock()
+	f.calls = append(f.calls, call{r.Method, r.URL.Path, r.URL.RawQuery, string(raw), r.Header.Clone()})
+	answer := f.answers[r.Method+" "+r.URL.Path]
+	cuentas, piezas, loose := f.cuentas, f.piezas, f.loose
+	f.mu.Unlock()
+	if r.Header.Get("Authorization") != "Bearer "+hooklineToken {
+		web.RespondError(w, http.StatusUnauthorized, "token")
+		return
+	}
+	if answer != nil {
+		answer(w, r)
+		return
+	}
+	switch r.Method + " " + r.URL.Path {
+	case "GET /api/estado":
+		web.Respond(w, http.StatusOK, map[string]any{"cuentas": cuentas, "piezas": piezas, "version": "test"})
+	case "GET /api/piezas":
+		c := r.URL.Query().Get("cuenta")
+		out := []map[string]any{}
+		for _, p := range piezas {
+			if c == "" || loose || p["cuenta"] == c {
+				out = append(out, p)
+			}
+		}
+		web.Respond(w, http.StatusOK, map[string]any{"piezas": out})
+	case "POST /api/pieza":
+		web.Respond(w, http.StatusOK, map[string]any{"ok": true})
+	case "GET /api/stats":
+		web.Respond(w, http.StatusOK, map[string]any{"cuenta": r.URL.Query().Get("cuenta"), "seguidores": 1200})
+	case "GET /api/comentarios":
+		web.Respond(w, http.StatusOK, map[string]any{"items": []map[string]any{{"id": "c1", "texto": "hola"}}})
+	case "POST /api/comentario":
+		web.Respond(w, http.StatusOK, map[string]any{"ok": true})
+	case "GET /mini":
+		w.Header().Set("Content-Type", "image/jpeg")
+		io.WriteString(w, jpeg)
+	default:
+		web.RespondError(w, http.StatusNotFound, "no existe")
+	}
+}
+
+// on sets the answer of a route.
+func (f *fakeHookline) on(route string, answer func(w http.ResponseWriter, r *http.Request)) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.answers[route] = answer
+}
+
+func (f *fakeHookline) seen() []call {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([]call(nil), f.calls...)
+}
+
+// count is how many requests to a route Hookline got.
+func (f *fakeHookline) count(method, path string) int {
+	n := 0
+	for _, c := range f.seen() {
+		if c.method == method && c.path == path {
+			n++
+		}
+	}
+	return n
+}
+
+func (f *fakeHookline) reset() {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.calls = nil
+}
