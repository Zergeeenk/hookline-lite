+// =============================================================================
+// Webhooks
+
+// hook sends a webhook to the agency, signed with secret at the time.
+func (w *world) hook(agency, secret string, at time.Time, body []byte) (int, []byte) {
+	w.t.Helper()
+	tiempo := strconv.FormatInt(at.Unix(), 10)
+	req, err := http.NewRequest(http.MethodPost, w.s.URL()+"/api/hookline/webhook/"+agency, strings.NewReader(string(body)))
+	if err != nil {
+		w.t.Fatal(err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-Hookline-Evento", "x")
+	req.Header.Set("X-Hookline-Tiempo", tiempo)
+	req.Header.Set("X-Hookline-Firma", hooklinebus.Sign(secret, tiempo, body))
+	res, err := w.s.Client().Do(req)
+	if err != nil {
+		w.t.Fatal(err)
+	}
+	defer res.Body.Close()
+	raw, _ := io.ReadAll(res.Body)
+	return res.StatusCode, raw
+}
+
+// told returns who has a notification of Hookline, and how many.
+func (w *world) told() map[int]int {
+	w.t.Helper()
+	rows, err := w.s.DB.Query(`SELECT user_id FROM notifications WHERE kind = $1`, hooklinebus.NotifKind)
+	if err != nil {
+		w.t.Fatal(err)
+	}
+	defer rows.Close()
+	out := map[int]int{}
+	for rows.Next() {
+		var id int
+		rows.Scan(&id)
+		out[id]++
+	}
+	return out
+}
