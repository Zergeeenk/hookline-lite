+	w.s.Expect(http.StatusOK, http.MethodPut, "/api/hookline/settings", w.admin, map[string]string{"url": w.f.srv.URL, "webhookSecret": webhookSecret}, nil)
+
+	for name, try := range map[string]func() (int, []byte){
+		"another secret": func() (int, []byte) {
