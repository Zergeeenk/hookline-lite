+func event(id int, tipo string, model any) []byte {
+	raw, _ := json.Marshal(map[string]any{
+		"id": id, "tipo": tipo, "creado": "2026-11-20T23:00:05+00:00",
+		"datos": map[string]any{"pieza": "p1", "cuenta": "pamela", "pyro_modelo_id": model, "error": "Instagram dijo que no", "dias": 2.5},
+	})
+	return raw
+}
