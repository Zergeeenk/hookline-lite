+// The connection is sealed, neither the token nor the secret comes back,
+// the fields are checked and the token does not follow a new address.
+func TestSettings(t *testing.T) {
+	w := newWorld(t)
+	for name, body := range map[string]map[string]string{
+		"no token":      {"url": w.f.srv.URL},
+		"short token":   {"url": w.f.srv.URL, "token": "corto"},
+		"spaced token":  {"url": w.f.srv.URL, "token": "un token con espacios adentro"},
+		"short secret":  {"url": w.f.srv.URL, "token": hooklineToken, "webhookSecret": "corto"},
+		"no url":        {"token": hooklineToken},
+		"not a url":     {"url": "hookline", "token": hooklineToken},
+		"with a path":   {"url": w.f.srv.URL + "/api", "token": hooklineToken},
+		"with a query":  {"url": w.f.srv.URL + "?a=1", "token": hooklineToken},
+		"with a user":   {"url": "https://a:b@hookline.example.net", "token": hooklineToken},
+		"ftp":           {"url": "ftp://hookline.example.net", "token": hooklineToken},
+		"link-local":    {"url": "https://169.254.169.254", "token": hooklineToken},
+		"unspecified":   {"url": "https://0.0.0.0", "token": hooklineToken},
+		"unspecified 6": {"url": "https://[::]", "token": hooklineToken},
+	} {
+		if status, raw := w.s.Do(http.MethodPut, "/api/hookline/settings", w.admin, body); status != http.StatusBadRequest {
+			t.Errorf("%s: %d %s", name, status, raw)
+		}
+	}
+
+	var s settings
+	status, raw := w.s.Do(http.MethodPut, "/api/hookline/settings", w.admin, map[string]string{"url": " " + w.f.srv.URL + "/ ", "token": hooklineToken, "webhookSecret": webhookSecret})
+	if status != http.StatusOK || strings.Contains(string(raw), hooklineToken) || strings.Contains(string(raw), webhookSecret) {
+		t.Fatalf("save: %d %s", status, raw)
+	}
+	json.Unmarshal(raw, &s)
+	if !s.Connected || s.URL != w.f.srv.URL || s.TokenHint != "6789" || !s.HasWebhookSecret || s.WebhookPath != "/api/hookline/webhook/1" {
+		t.Fatalf("saved %+v", s)
+	}
+	status, raw = w.s.Do(http.MethodGet, "/api/hookline/settings", w.admin, nil)
+	if status != http.StatusOK || strings.Contains(string(raw), hooklineToken) || strings.Contains(string(raw), webhookSecret) {
+		t.Fatalf("read: %d %s", status, raw)
+	}
+
+	var sealed []byte
+	if err := w.s.DB.QueryRow(`SELECT connection FROM hookline_settings WHERE agency_id = $1`, apitest.Agency).Scan(&sealed); err != nil {
+		t.Fatal(err)
+	}
+	for _, plain := range []string{hooklineToken, webhookSecret, w.f.srv.URL} {
+		if strings.Contains(string(sealed), plain) {
+			t.Fatalf("%q is in the database in the clear", plain)
+		}
+	}
+
+	// Saving the same address without a token or a secret keeps them.
+	w.s.Expect(http.StatusOK, http.MethodPut, "/api/hookline/settings", w.admin, map[string]string{"url": w.f.srv.URL}, &s)
+	if s.TokenHint != "6789" || !s.HasWebhookSecret {
+		t.Fatalf("saved again %+v", s)
+	}
+	w.s.Expect(http.StatusOK, http.MethodGet, "/api/hookline/cuentas", w.admin, nil, nil)
+
+	// Another address needs the token again.
+	other := newFake(t)
+	status, raw = w.s.Do(http.MethodPut, "/api/hookline/settings", w.admin, map[string]string{"url": other.srv.URL})
+	if status != http.StatusBadRequest || !strings.Contains(string(raw), `"token"`) {
+		t.Fatalf("another address: %d %s", status, raw)
+	}
+	if got := other.seen(); len(got) != 0 {
+		t.Fatalf("the token went to the other address: %+v", got)
+	}
+
+	// Probar says whether it works.
+	var check struct {
+		OK      bool   `json:"ok"`
+		Reason  string `json:"reason"`
+		Cuentas int    `json:"cuentas"`
+	}
+	w.s.Expect(http.StatusOK, http.MethodPost, "/api/hookline/settings/test", w.admin, nil, &check)
+	if !check.OK || check.Cuentas != 3 {
+		t.Fatalf("check %+v", check)
+	}
+	w.f.on("GET /api/estado", func(w http.ResponseWriter, r *http.Request) {
+		web.RespondError(w, http.StatusUnauthorized, "token")
+	})
+	w.s.Expect(http.StatusOK, http.MethodPost, "/api/hookline/settings/test", w.admin, nil, &check)
+	if check.OK || check.Reason != "refused" {
+		t.Fatalf("check %+v", check)
+	}
+}
