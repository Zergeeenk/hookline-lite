+	}
+	if got := w.f.seen(); len(got) != 0 {
+		t.Fatalf("a webhook called Hookline: %+v", got)
+	}
+}
+
+// raw sends body signed as if it were signed, another body.
+func (w *world) raw(signedBody, body []byte, at time.Time) (int, []byte) {
+	tiempo := strconv.FormatInt(at.Unix(), 10)
+	return w.rawWith(body, at, map[string]string{"X-Hookline-Firma": hooklinebus.Sign(webhookSecret, tiempo, signedBody)})
+}
+
+// rawWith sends a webhook signed well, with the headers in set changed.
+func (w *world) rawWith(body []byte, at time.Time, set map[string]string) (int, []byte) {
+	w.t.Helper()
+	tiempo := strconv.FormatInt(at.Unix(), 10)
+	req, _ := http.NewRequest(http.MethodPost, w.s.URL()+"/api/hookline/webhook/1", strings.NewReader(string(body)))
+	req.Header.Set("X-Hookline-Tiempo", tiempo)
+	req.Header.Set("X-Hookline-Firma", hooklinebus.Sign(webhookSecret, tiempo, body))
+	for k, v := range set {
+		req.Header.Set(k, v)
+	}
+	res, err := w.s.Client().Do(req)
+	if err != nil {
+		w.t.Fatal(err)
+	}
+	defer res.Body.Close()
+	raw, _ := io.ReadAll(res.Body)
+	return res.StatusCode, raw
+}
