+// Every route asks for its permission before anything is called.
+func TestGates(t *testing.T) {
+	w := newWorld(t)
+	w.connect()
+	for _, r := range listRoutes() {
+		if status, raw := w.s.Do(r.method, r.path, w.outside, r.body); status != http.StatusForbidden {
+			t.Errorf("no permission: %s %s: %d %s", r.method, r.path, status, raw)
+		}
+		if r.need == "edit" || r.need == "admin" {
+			if status, raw := w.s.Do(r.method, r.path, w.lect, r.body); status != http.StatusForbidden {
+				t.Errorf("reader: %s %s: %d %s", r.method, r.path, status, raw)
+			}
+		}
+		if r.need == "admin" {
+			if status, raw := w.s.Do(r.method, r.path, w.editor, r.body); status != http.StatusForbidden {
+				t.Errorf("editor: %s %s: %d %s", r.method, r.path, status, raw)
+			}
+		}
+		if status, _ := w.s.Do(r.method, r.path, "", r.body); status != http.StatusUnauthorized {
+			t.Errorf("no token: %s %s: %d", r.method, r.path, status)
+		}
+	}
+	if got := w.f.seen(); len(got) != 0 {
+		t.Fatalf("reached Hookline: %+v", got)
+	}
+
+	// Each one does what it is for, with the permission.
+	for _, r := range listRoutes() {
+		tok := w.admin
+		switch r.need {
+		case "view":
+			tok = w.lect
+		case "edit":
+			tok = w.editor
+		}
+		if r.method == http.MethodDelete || r.method == http.MethodPut {
+			continue
+		}
+		if status, raw := w.s.Do(r.method, r.path, tok, r.body); status != http.StatusOK {
+			t.Errorf("%s %s: %d %s", r.method, r.path, status, raw)
+		}
+	}
+}
